---
interface Props {
  introAnimation?: boolean;
}

const { introAnimation = false } = Astro.props;
---

<header
  class={`header ${introAnimation ? "header--intro" : ""}`}
  id="site-header"
  role="banner"
>
  <div class="header-bar">
    <!-- Brand -->
    <a href="/" class="brand" aria-label="Ivan Mendez — Home">
      <span class="brand-mark" aria-hidden="true">IM</span>
      <span class="brand-name">Ivan Mendez</span>
    </a>

    <!-- Mobile toggle -->
    <button
      class="menu-toggle"
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span class="sr-only">Open menu</span>
      <span class="menu-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- Nav (desktop: inline in the pill bar) -->
    <nav id="site-nav" class="nav" role="navigation" aria-label="Primary">
      <div class="nav-links">
        <a href="/" class="nav-link" data-i18n="nav.home">Home</a>
        <a href="/blog" class="nav-link" data-i18n="nav.blog">Blog</a>
        <a href="/projects" class="nav-link" data-i18n="nav.projects"
          >Projects</a
        >
        <a href="/cv" class="nav-link" data-i18n="nav.cv">CV</a>
      </div>

      <div class="nav-actions">
        <!-- Toggles Container -->
        <div class="header-toggles">
          <!-- Language Toggle -->
          <button
            class="lang-toggle"
            aria-label="Change language"
            title="Change language"
          >
            <span class="lang-current">EN</span>
          </button>

          <!-- Theme Toggle -->
          <button
            class="theme-toggle"
            aria-label="Toggle dark mode"
            title="Toggle theme"
          >
            <svg
              class="icon-sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg
              class="icon-moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
              ></path>
            </svg>
          </button>
        </div>

        <a href="/contact" class="nav-cta">
          <span data-i18n="nav.contact">Contact</span>
          <svg
            class="nav-cta__icon"
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
          >
            <path
              d="M3.5 8h9M8.5 3.5L13 8l-4.5 4.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 1.1rem 1.5rem 0;
      background: transparent;
      transition: padding var(--transition-base);
    }
    :global([data-theme="dark"]) .header {
      background: transparent;
    }

    /* Delayed reveal: only used on the homepage, once the hero intro has
       landed the name (see /js/hero.js). Everywhere else the header
       renders visible immediately. */
    .header--intro {
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }
    .header--intro.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .header--intro {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    .header-bar {
      position: relative;
      isolation: isolate;
      max-width: calc(var(--max-width-content) - 3rem);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.6rem 0.6rem 0.6rem 1.25rem;
      border-radius: 999px;
      border: 1px solid var(--color-gray-200);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      transition:
        box-shadow var(--transition-base),
        border-color var(--transition-base);
    }
    /* The frosted-glass fill lives on a pseudo-element (not on .header-bar
       itself) so backdrop-filter never turns .header-bar into the containing
       block for the fixed-position mobile nav overlay nested inside it. */
    .header-bar::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: saturate(180%) blur(20px);
      transition: background-color var(--transition-base);
    }
    :global([data-theme="dark"]) .header-bar {
      border-color: #262626;
    }
    :global([data-theme="dark"]) .header-bar::before {
      background: rgba(15, 15, 15, 0.72);
    }

    .header.is-scrolled .header-bar {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }
    .header.is-scrolled .header-bar::before {
      background: rgba(255, 255, 255, 0.92);
    }
    :global([data-theme="dark"]) .header.is-scrolled .header-bar {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }
    :global([data-theme="dark"]) .header.is-scrolled .header-bar::before {
      background: rgba(10, 10, 10, 0.92);
    }

    /* Brand */
    .brand {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
      flex-shrink: 0;
    }
    .brand-mark {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--color-black);
      color: var(--color-white);
      font-size: 0.75rem;
      font-weight: var(--font-weight-black);
      letter-spacing: -0.01em;
      flex-shrink: 0;
    }
    .brand-name {
      font-size: 1.0625rem;
      font-weight: var(--font-weight-black);
      color: var(--color-black);
      letter-spacing: -0.03em;
      white-space: nowrap;
    }

    /* Mobile toggle hidden on desktop */
    .menu-toggle {
      position: relative;
      z-index: 51;
      display: none;
      border: 0;
      background: transparent;
      padding: 0.5rem;
      border-radius: 50%;
      margin-left: auto;
    }
    .menu-toggle:hover {
      background: var(--color-gray-100);
    }
    .menu-toggle:focus-visible {
      outline: 2px solid var(--color-black);
      outline-offset: 2px;
    }
    .menu-toggle__bars {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 20px;
      height: 16px;
    }
    .menu-toggle__bars span {
      display: block;
      height: 1.5px;
      background: var(--color-black);
      border-radius: 1px;
      transition:
        transform var(--transition-base),
        opacity var(--transition-base);
    }
    .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }
    .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex: 1;
      gap: 0.5rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.15rem;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-left: 0.75rem;
      padding-left: 0.75rem;
      border-left: 1px solid var(--color-gray-200);
    }
    :global([data-theme="dark"]) .nav-actions {
      border-left-color: #262626;
    }

    .header-toggles {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .nav-link {
      position: relative;
      font-size: 0.8125rem;
      font-weight: var(--font-weight-semibold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-gray-600);
      text-decoration: none;
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      transition:
        color var(--transition-fast),
        background-color var(--transition-fast);
    }
    .nav-link:hover,
    .nav-link:focus-visible {
      color: var(--color-black);
      background-color: var(--color-gray-100);
      outline: none;
    }
    /* active state */
    .nav-link.is-active {
      color: var(--color-white);
      background-color: var(--color-black);
    }
    :global([data-theme="dark"]) .nav-link.is-active {
      color: #0a0a0a;
      background-color: #ffffff;
    }

    /* solid pill CTA for Contact, matching the site's primary button style */
    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8125rem;
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-decoration: none;
      padding: 0.6rem 1.1rem;
      border-radius: 999px;
      color: var(--color-white);
      background-color: var(--color-black);
      transition:
        transform var(--transition-base),
        opacity var(--transition-base);
    }
    :global([data-theme="dark"]) .nav-cta {
      color: #0a0a0a;
      background-color: #ffffff;
    }
    .nav-cta__icon {
      transition: transform var(--transition-base);
    }
    .nav-cta:hover,
    .nav-cta:focus-visible {
      transform: translateY(-2px);
      opacity: 1;
      color: var(--color-white);
    }
    :global([data-theme="dark"]) .nav-cta:hover,
    :global([data-theme="dark"]) .nav-cta:focus-visible {
      color: #0a0a0a;
    }
    .nav-cta:hover .nav-cta__icon {
      transform: translateX(2px);
    }

    /* Theme toggle button */
    .theme-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border: 1px solid var(--color-gray-200);
      border-radius: 999px;
      background: transparent;
      color: var(--color-gray-600);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .theme-toggle:hover {
      border-color: var(--color-black);
      color: var(--color-black);
      transform: translateY(-2px);
    }
    :global([data-theme="dark"]) .theme-toggle:hover {
      border-color: #ffffff;
      color: #ffffff;
    }
    .theme-toggle:focus-visible {
      outline: 2px solid var(--color-black);
      outline-offset: 2px;
    }

    /* Icon visibility */
    .theme-toggle .icon-moon {
      display: none;
    }
    :global([data-theme="dark"]) .theme-toggle .icon-sun {
      display: none;
    }
    :global([data-theme="dark"]) .theme-toggle .icon-moon {
      display: block;
    }

    /* Language toggle */
    .lang-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 34px;
      padding: 0 0.8rem;
      border: 1px solid var(--color-gray-200);
      border-radius: 999px;
      background: transparent;
      color: var(--color-gray-600);
      cursor: pointer;
      transition: all var(--transition-fast);
      font-size: 0.75rem;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0.04em;
    }
    .lang-toggle:hover {
      border-color: var(--color-black);
      color: var(--color-black);
      transform: translateY(-2px);
    }
    :global([data-theme="dark"]) .lang-toggle:hover {
      border-color: #ffffff;
      color: #ffffff;
    }
    .lang-toggle:focus-visible {
      outline: 2px solid var(--color-black);
      outline-offset: 2px;
    }
    .lang-current {
      text-transform: uppercase;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .header {
        padding: 0.75rem 1rem 0;
      }
      .header-bar {
        padding: 0.5rem 0.5rem 0.5rem 0.9rem;
        border-radius: 1.5rem;
      }
      .brand-name {
        font-size: 0.9375rem;
      }
      .menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .nav {
        position: fixed;
        inset: 0;
        z-index: 49;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        visibility: hidden;
        opacity: 0;
        background: var(--color-white);
        transition:
          opacity var(--transition-base),
          visibility var(--transition-base);
      }
      :global([data-theme="dark"]) .nav {
        background: #0a0a0a;
      }
      .nav.open {
        visibility: visible;
        opacity: 1;
      }

      .nav-links {
        flex-direction: column;
        align-items: stretch;
        gap: 0.25rem;
        width: 100%;
        max-width: 22rem;
      }
      .nav-link {
        font-size: 1.5rem;
        text-align: center;
        text-transform: none;
        letter-spacing: -0.01em;
        font-weight: var(--font-weight-bold);
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        color: var(--color-black);
        background-color: transparent;
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.35s ease,
          transform 0.35s ease,
          background-color var(--transition-fast);
      }
      .nav.open .nav-link {
        opacity: 1;
        transform: translateY(0);
      }
      .nav.open .nav-link:nth-child(1) {
        transition-delay: 0.05s;
      }
      .nav.open .nav-link:nth-child(2) {
        transition-delay: 0.1s;
      }
      .nav.open .nav-link:nth-child(3) {
        transition-delay: 0.15s;
      }
      .nav.open .nav-link:nth-child(4) {
        transition-delay: 0.2s;
      }
      .nav-link.is-active {
        color: var(--color-white);
        background-color: var(--color-black);
      }
      :global([data-theme="dark"]) .nav-link.is-active {
        color: #0a0a0a;
        background-color: #ffffff;
      }

      .nav-actions {
        flex-direction: column;
        align-items: stretch;
        margin-left: 0;
        padding-left: 0;
        border-left: none;
        margin-top: 2rem;
        gap: 1.25rem;
        width: 100%;
        max-width: 22rem;
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.35s ease 0.25s,
          transform 0.35s ease 0.25s;
      }
      .nav.open .nav-actions {
        opacity: 1;
        transform: translateY(0);
      }
      .header-toggles {
        justify-content: center;
      }
      .nav-cta {
        justify-content: center;
        padding: 0.9rem 1.5rem;
        font-size: 0.875rem;
      }
    }
  </style>

  <script>
    // Active link based on current path
    (function () {
      const path = location.pathname.replace(/\/+$/, "") || "/";
      document.querySelectorAll(".nav-link").forEach((a) => {
        const href = a.getAttribute("href");
        if (!href) return;

        const normalized = href === "/" ? "/" : href.replace(/\/+$/, "");
        if (normalized === "/" ? path === "/" : path.startsWith(normalized)) {
          a.classList.add("is-active");
          a.setAttribute("aria-current", "page");
        }
      });

      // Mobile toggle
      const btn = document.querySelector(".menu-toggle");
      const nav = document.getElementById("site-nav");
      if (btn && nav) {
        btn.addEventListener("click", () => {
          const open = nav.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(open));
          document.body.style.overflow = open ? "hidden" : "";
        });
        // close on link click
        nav.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            nav.classList.remove("open");
            btn.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
          }),
        );
      }

      // Shrink / elevate header on scroll
      const header = document.getElementById("site-header");
      if (header) {
        const onScroll = () => {
          header.classList.toggle("is-scrolled", window.scrollY > 8);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // Theme toggle
      const themeToggle = document.querySelector(".theme-toggle");
      const html = document.documentElement;

      // Check for saved theme or system preference
      const savedTheme = localStorage.getItem("theme");
      const systemPrefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      if (savedTheme === "dark" || (!savedTheme && systemPrefersDark)) {
        html.setAttribute("data-theme", "dark");
      }

      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const isDark = html.getAttribute("data-theme") === "dark";
          const newTheme = isDark ? "light" : "dark";

          html.setAttribute("data-theme", newTheme);
          localStorage.setItem("theme", newTheme);
        });
      }

      // Language toggle
      const langToggle = document.querySelector(".lang-toggle");
      const langCurrent = document.querySelector(".lang-current");

      // Get saved language or default to 'en'
      const savedLang = localStorage.getItem("lang") || "en";
      html.setAttribute("data-lang", savedLang);
      if (langCurrent) {
        langCurrent.textContent = savedLang.toUpperCase();
      }

      if (langToggle && langCurrent) {
        langToggle.addEventListener("click", () => {
          const currentLang = html.getAttribute("data-lang") || "en";
          const newLang = currentLang === "en" ? "es" : "en";

          html.setAttribute("data-lang", newLang);
          localStorage.setItem("lang", newLang);
          langCurrent.textContent = newLang.toUpperCase();

          // Dispatch custom event for other components to react
          window.dispatchEvent(
            new CustomEvent("langchange", { detail: { lang: newLang } }),
          );
        });
      }
    })();
  </script>
</header>
