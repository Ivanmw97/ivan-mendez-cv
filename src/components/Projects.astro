---
interface Project {
  title: string;
  description: string;
  technologies: string[];
  link?: string;
  image?: string;
  playStoreLink?: string;
  appStoreLink?: string;
}

interface Props {
  projects: Project[];
  sectionTitle?: string;
}

const { projects, sectionTitle = "Projects" } = Astro.props;
---

<section class="projects-section">
  <div class="projects-container">
    <h2 class="section-title">
      {sectionTitle}
    </h2>

    <div class="projects-grid">
      {
        projects.map((project) => {
          const isGithubLink = project.link?.includes("github.com");
          return (
          <article class="project-card">
            <div class="project-header">
              <h3 class="project-title">{project.title}</h3>
              <div class="project-links">
                {project.playStoreLink && (
                  <a
                    href={project.playStoreLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                    aria-label="Google Play"
                    title="Google Play"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </a>
                )}
                {project.appStoreLink && (
                  <a
                    href={project.appStoreLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                    aria-label="App Store"
                    title="App Store"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.207-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-2.09-.87-3.833-.87-1.79 0-2.335.87-3.833.87-1.48 0-2.55-1.33-3.5-2.66-1.9-2.6-3.35-7.35-1.4-10.85.97-1.75 2.72-2.86 4.6-2.89 1.44-.03 2.79.97 3.833.97.994 0 2.68-1.2 4.5-1.02.77.03 2.93.31 4.32 2.34-.11.07-2.58 1.51-2.56 4.5.03 3.57 3.15 4.76 3.19 4.78z" />
                    </svg>
                  </a>
                )}
                {project.link && isGithubLink && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                    aria-label="GitHub"
                    title="GitHub"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98.01 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z" />
                    </svg>
                  </a>
                )}
                {project.link && !isGithubLink && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                    aria-label="Live Demo"
                    title="Live Demo"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <p class="project-description">{project.description}</p>

            <div class="project-technologies">
              {project.technologies.slice(0, 5).map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 4rem 2rem;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-gray-200);
  }
  :global([data-theme="dark"]) .projects-section {
    background-color: #0a0a0a;
    border-bottom-color: #262626;
  }

  .projects-container {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-black);
    margin-bottom: 2.5rem;
  }
  :global([data-theme="dark"]) .section-title {
    color: #ffffff;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 0.75rem;
    background-color: var(--color-white);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }
  :global([data-theme="dark"]) .project-card {
    background-color: #171717;
    border-color: #262626;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .project-title {
    flex: 1 1 160px;
    min-width: 0;
    font-size: 1.25rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-black);
  }
  :global([data-theme="dark"]) .project-title {
    color: #ffffff;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .project-link {
    color: var(--color-gray-600);
    transition: color var(--transition-fast);
    flex-shrink: 0;
  }

  .project-link:hover {
    color: var(--color-black);
    opacity: 1;
  }

  .project-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-gray-700);
    margin-bottom: 1.25rem;
  }
  :global([data-theme="dark"]) .project-description {
    color: #a3a3a3;
  }

  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-gray-600);
    background-color: var(--color-gray-100);
    border-radius: 0.25rem;
  }
  :global([data-theme="dark"]) .tech-tag {
    color: #d4d4d4;
    background-color: #262626;
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 3rem 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
