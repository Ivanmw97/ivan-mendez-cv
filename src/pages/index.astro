---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header introAnimation />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-bg__blob hero-bg__blob--1"></span>
      <span class="hero-bg__blob hero-bg__blob--2"></span>
    </div>

    <!-- Intro: the "IM" monogram punches in, then its two letters split
         apart to reveal the name from between them. -->
    <span class="hero-mark" aria-hidden="true"
      ><span class="hero-mark__i">I</span><span class="hero-mark__m">M</span></span
    >

    <div class="hero-container">
      <p
        class="hero-label hero-reveal"
        data-i18n="home.heroLabel"
        style="--reveal-delay: 1.22s;">Mobile Engineer</p
      >
      <h1 class="hero-title hero-name">
        <span class="hero-title__text">Iván Méndez</span>
      </h1>
      <p class="hero-role hero-reveal" style="--reveal-delay: 1.34s;">
        <span class="hero-role__text"></span>
      </p>
    </div>

    <button
      class="scroll-indicator"
      type="button"
      aria-label="Scroll to next section"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
  </section>

  <!-- SUMMARY -->
  <section class="section summary-section">
    <div class="section-inner">
      <p class="summary-text" data-i18n="home.summary">
        I design and build mobile applications for Android and iOS, from native
        Kotlin and Swift to cross-platform Flutter. With a product-focused
        mindset and a strong foundation in clean architecture, I deliver
        reliable, scalable software that solves real problems. I also build
        modern web applications when the project calls for it.
      </p>
    </div>
  </section>

  <!-- EXPERTISE -->
  <section class="section expertise-section">
    <div class="section-inner">
      <h2 class="section-heading" data-i18n="home.expertiseTitle">
        Core Expertise
      </h2>
      <div class="expertise-grid">
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise1Title">
            Native Android
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise1Desc">
            Kotlin, Jetpack Compose, MVVM, and the modern Android stack.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise2Title">
            Native iOS
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise2Desc">
            Swift, SwiftUI, UIKit, and Apple platform best practices.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise3Title">
            Cross-Platform
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise3Desc">
            Flutter & Dart for high-performance, single-codebase mobile apps.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise4Title">
            Architecture
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise4Desc">
            Clean Architecture, SOLID principles, and scalable project
            structure.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise5Title">
            Performance
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise5Desc">
            Optimized builds, efficient rendering, and production-grade
            reliability.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise6Title">
            Web Development
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise6Desc">
            Modern frontend with React, Astro, and responsive design systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner cta-inner">
      <h2 class="section-heading" data-i18n="home.ctaTitle">
        Let's Work Together
      </h2>
      <p class="cta-desc" data-i18n="home.ctaDesc">
        Looking for a mobile engineer or have a project in mind? I'd like to
        hear about it.
      </p>
      <div class="cta-buttons">
        <a
          href="/projects"
          class="cta-button cta-button--primary"
          data-i18n="home.viewProjects">View All Projects →</a
        >
        <a
          href="/cv"
          class="cta-button cta-button--secondary"
          data-i18n="home.downloadCV">Download CV</a
        >
        <a
          href="/contact"
          class="cta-button cta-button--secondary"
          data-i18n="home.contactMe">Contact Me</a
        >
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Match the page background to the hero's so nothing shows through
     the transparent header strip while it's hidden during the intro. */
  :global(body) {
    background-color: var(--color-gray-50);
  }
  :global([data-theme="dark"] body) {
    background-color: #0a0a0a;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 4.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background-color: var(--color-gray-50);
  }
  :global([data-theme="dark"]) .hero {
    background-color: #0a0a0a;
  }

  /* ── Ambient background ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    will-change: transform;
  }

  .hero-bg__blob--1 {
    top: -8rem;
    left: -6rem;
    width: 26rem;
    height: 26rem;
    background: var(--color-gray-300);
    animation: hero-drift-1 16s ease-in-out infinite alternate;
  }
  :global([data-theme="dark"]) .hero-bg__blob--1 {
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-bg__blob--2 {
    bottom: -10rem;
    right: -6rem;
    width: 24rem;
    height: 24rem;
    background: var(--color-gray-200);
    animation: hero-drift-2 20s ease-in-out infinite alternate;
  }
  :global([data-theme="dark"]) .hero-bg__blob--2 {
    background: rgba(255, 255, 255, 0.04);
  }

  @keyframes hero-drift-1 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(50px, 40px) scale(1.12);
    }
  }
  @keyframes hero-drift-2 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(-40px, -30px) scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg__blob {
      animation: none;
    }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    will-change: transform;
    transform: translateY(0);
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--color-gray-300);
    background: transparent;
    color: var(--color-gray-500);
    cursor: pointer;
    padding: 0;
    opacity: 0;
    transform: translateX(-50%);
    animation:
      hero-bounce 2.4s ease-in-out infinite,
      hero-fade-in 0.4s ease 1.75s forwards;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast);
  }
  .scroll-indicator:hover {
    border-color: var(--color-black);
    color: var(--color-black);
    background: var(--color-gray-100);
  }
  :global([data-theme="dark"]) .scroll-indicator {
    border-color: #404040;
    color: #a3a3a3;
  }
  :global([data-theme="dark"]) .scroll-indicator:hover {
    border-color: #ffffff;
    color: #ffffff;
    background: #171717;
  }
  .scroll-indicator:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 3px;
  }

  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }
  @keyframes hero-fade-in {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator {
      opacity: 1;
      animation: none;
    }
  }

  .hero-label {
    font-size: 1rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin: 0;
  }

  .hero-title {
    font-size: 6rem;
    font-weight: var(--font-weight-black);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-black);
    margin: 0;
  }
  :global([data-theme="dark"]) .hero-title {
    color: #ffffff;
  }

  .hero-role {
    font-size: 1.5rem;
    font-weight: var(--font-weight-normal);
    line-height: 1.5;
    color: var(--color-gray-600);
    margin: 0;
  }
  :global([data-theme="dark"]) .hero-role {
    color: #a3a3a3;
  }

  /* ── Shared section ── */
  .section {
    padding: 5rem 2rem;
  }

  .section-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-black);
    margin: 0 0 1.5rem;
  }
  :global([data-theme="dark"]) .section-heading {
    color: #ffffff;
  }

  /* ── Summary ── */
  .summary-section {
    border-top: 1px solid var(--color-gray-200);
  }

  .summary-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-gray-600);
    max-width: 48rem;
  }
  :global([data-theme="dark"]) .summary-text {
    color: #a3a3a3;
  }

  /* ── Expertise grid ── */
  .expertise-section {
    border-top: 1px solid var(--color-gray-200);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .expertise-item {
    padding: 1.5rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 12px;
    transition: border-color var(--transition-base);
  }

  .expertise-item:hover {
    border-color: var(--color-gray-400);
  }

  .expertise-item__title {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  :global([data-theme="dark"]) .expertise-item__title {
    color: #ffffff;
  }

  .expertise-item__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray-500);
    margin: 0;
  }

  /* ── CTA section ── */
  .cta-section {
    border-top: 1px solid var(--color-gray-200);
    background-color: var(--color-gray-50);
  }
  :global([data-theme="dark"]) .cta-section {
    background-color: #0f0f0f;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-600);
    max-width: 36rem;
    margin: 0 0 2rem;
  }
  :global([data-theme="dark"]) .cta-desc {
    color: #a3a3a3;
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium);
    border-radius: 2rem;
    transition: all var(--transition-base);
    text-decoration: none;
  }

  .cta-button--primary {
    color: var(--color-white);
    background-color: var(--color-black);
  }
  :global([data-theme="dark"]) .cta-button--primary {
    color: #0a0a0a;
    background-color: #ffffff;
  }

  .cta-button--secondary {
    color: var(--color-black);
    background-color: transparent;
    border: 1px solid var(--color-gray-300);
  }
  :global([data-theme="dark"]) .cta-button--secondary {
    color: #ffffff;
    background-color: transparent;
    border-color: #404040;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    opacity: 1;
  }
  .cta-button--primary:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }
  .cta-button--secondary:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
    border-color: var(--color-gray-400);
  }

  /* ── Intro: "IM" punches in, then splits open to reveal the name ── */
  .hero-title {
    min-height: 1.2em;
    /* headroom so the clip-path wipe can never crop the accents */
    padding-block: 0.14em;
    margin-block: -0.14em;
  }

  .hero-role {
    min-height: 1.5em;
  }

  /* The monogram slams in from almost nothing, overshoots, settles — then
     its two letters fly apart and shrink down to the size of the name's
     initials while the name itself is wiped open from between them. */
  .hero-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: block;
    white-space: nowrap;
    font-size: clamp(5.5rem, 18vw, 15rem);
    font-weight: var(--font-weight-black);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-black);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.04);
    animation: hero-mark-punch 0.42s forwards;
  }
  :global([data-theme="dark"]) .hero-mark {
    color: #ffffff;
  }

  .hero-mark span {
    display: inline-block;
    opacity: 1;
    filter: blur(0);
    transform: translateX(0) scale(1) rotate(0deg);
  }
  .hero-mark__i {
    animation: hero-mark-split-left 0.44s cubic-bezier(0.55, 0, 0.3, 1) 0.66s
      forwards;
  }
  .hero-mark__m {
    animation: hero-mark-split-right 0.44s cubic-bezier(0.55, 0, 0.3, 1) 0.66s
      forwards;
  }

  @keyframes hero-mark-punch {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.04);
      animation-timing-function: cubic-bezier(0.5, 0, 0.35, 1);
    }
    30% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.5);
      animation-timing-function: cubic-bezier(0.25, 0, 0.25, 1);
    }
    62% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.16);
      animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes hero-mark-split-left {
    0% {
      opacity: 1;
      filter: blur(0);
      transform: translateX(0) scale(1) rotate(0deg);
    }
    100% {
      opacity: 0;
      filter: blur(7px);
      transform: translateX(-0.85em) scale(0.42) rotate(-5deg);
    }
  }

  @keyframes hero-mark-split-right {
    0% {
      opacity: 1;
      filter: blur(0);
      transform: translateX(0) scale(1) rotate(0deg);
    }
    100% {
      opacity: 0;
      filter: blur(7px);
      transform: translateX(0.85em) scale(0.42) rotate(5deg);
    }
  }

  /* The name is wiped open from the centre outwards, through the gap the
     two letters leave behind. */
  .hero-name {
    opacity: 0;
    clip-path: inset(0 50% 0 50%);
    transform: scale(0.92);
    animation: hero-name-reveal 0.58s cubic-bezier(0.16, 1, 0.3, 1) 0.74s
      forwards;
  }

  @keyframes hero-name-reveal {
    0% {
      opacity: 0;
      clip-path: inset(0 50% 0 50%);
      transform: scale(0.92);
    }
    25% {
      opacity: 1;
      clip-path: inset(0 34% 0 34%);
      transform: scale(0.96);
    }
    100% {
      opacity: 1;
      clip-path: inset(0 0 0 0);
      transform: scale(1);
    }
  }

  /* Supporting lines then snap into place, quickly and in order. */
  .hero-reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-text-in 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes hero-text-in {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark {
      display: none;
    }
    .hero-reveal,
    .hero-name {
      opacity: 1;
      clip-path: none;
      transform: none;
      animation: none;
    }
  }

  /* ── Tablet ── */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 4.5rem;
    }
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      min-height: calc(100vh - 4rem);
      padding: 3rem 1.5rem;
    }
    .hero-title {
      font-size: 3.25rem;
    }
    .hero-role {
      font-size: 1.25rem;
    }
    .scroll-indicator {
      bottom: 1.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }
    .hero-bg__blob--1,
    .hero-bg__blob--2 {
      width: 16rem;
      height: 16rem;
    }
    .section {
      padding: 3.5rem 1.5rem;
    }
    .section-heading {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .expertise-grid {
      grid-template-columns: 1fr;
    }
    .cta-buttons {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script is:inline src="/js/hero.js"></script>
