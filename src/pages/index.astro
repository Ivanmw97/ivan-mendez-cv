---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-container">
      <p class="hero-label" data-i18n="home.heroLabel">Mobile Engineer</p>
      <h1 class="hero-title">Iván Méndez</h1>
      <p class="hero-role" data-i18n="home.heroRole">Android · iOS · Flutter</p>
    </div>
  </section>

  <!-- SUMMARY -->
  <section class="section summary-section">
    <div class="section-inner">
      <p class="summary-text" data-i18n="home.summary">
        I design and build mobile applications for Android and iOS, from native
        Kotlin and Swift to cross-platform Flutter. With a product-focused
        mindset and a strong foundation in clean architecture, I deliver
        reliable, scalable software that solves real problems. I also build
        modern web applications when the project calls for it.
      </p>
    </div>
  </section>

  <!-- EXPERTISE -->
  <section class="section expertise-section">
    <div class="section-inner">
      <h2 class="section-heading" data-i18n="home.expertiseTitle">
        Core Expertise
      </h2>
      <div class="expertise-grid">
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise1Title">
            Native Android
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise1Desc">
            Kotlin, Jetpack Compose, MVVM, and the modern Android stack.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise2Title">
            Native iOS
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise2Desc">
            Swift, SwiftUI, UIKit, and Apple platform best practices.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise3Title">
            Cross-Platform
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise3Desc">
            Flutter & Dart for high-performance, single-codebase mobile apps.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise4Title">
            Architecture
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise4Desc">
            Clean Architecture, SOLID principles, and scalable project
            structure.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise5Title">
            Performance
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise5Desc">
            Optimized builds, efficient rendering, and production-grade
            reliability.
          </p>
        </div>
        <div class="expertise-item">
          <h3 class="expertise-item__title" data-i18n="home.expertise6Title">
            Web Development
          </h3>
          <p class="expertise-item__desc" data-i18n="home.expertise6Desc">
            Modern frontend with React, Astro, and responsive design systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner cta-inner">
      <h2 class="section-heading" data-i18n="home.ctaTitle">
        Let's Work Together
      </h2>
      <p class="cta-desc" data-i18n="home.ctaDesc">
        Looking for a mobile engineer or have a project in mind? I'd like to
        hear about it.
      </p>
      <div class="cta-buttons">
        <a
          href="/projects"
          class="cta-button cta-button--primary"
          data-i18n="home.viewProjects">View All Projects →</a
        >
        <a
          href="/cv"
          class="cta-button cta-button--secondary"
          data-i18n="home.downloadCV">Download CV</a
        >
        <a
          href="/contact"
          class="cta-button cta-button--secondary"
          data-i18n="home.contactMe">Contact Me</a
        >
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    min-height: calc(100vh - 4.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background-color: var(--color-gray-50);
  }
  :global([data-theme="dark"]) .hero {
    background-color: #0a0a0a;
  }

  .hero-container {
    max-width: 56rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    will-change: transform;
    transform: translateY(0);
  }

  .hero-label {
    font-size: 1rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin: 0;
  }

  .hero-title {
    font-size: 6rem;
    font-weight: var(--font-weight-black);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-black);
    margin: 0;
  }
  :global([data-theme="dark"]) .hero-title {
    color: #ffffff;
  }

  .hero-role {
    font-size: 1.5rem;
    font-weight: var(--font-weight-normal);
    line-height: 1.5;
    color: var(--color-gray-600);
    margin: 0;
  }
  :global([data-theme="dark"]) .hero-role {
    color: #a3a3a3;
  }

  /* ── Shared section ── */
  .section {
    padding: 5rem 2rem;
  }

  .section-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-black);
    margin: 0 0 1.5rem;
  }
  :global([data-theme="dark"]) .section-heading {
    color: #ffffff;
  }

  /* ── Summary ── */
  .summary-section {
    border-top: 1px solid var(--color-gray-200);
  }

  .summary-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-gray-600);
    max-width: 48rem;
  }
  :global([data-theme="dark"]) .summary-text {
    color: #a3a3a3;
  }

  /* ── Expertise grid ── */
  .expertise-section {
    border-top: 1px solid var(--color-gray-200);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .expertise-item {
    padding: 1.5rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 12px;
    transition: border-color var(--transition-base);
  }

  .expertise-item:hover {
    border-color: var(--color-gray-400);
  }

  .expertise-item__title {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }
  :global([data-theme="dark"]) .expertise-item__title {
    color: #ffffff;
  }

  .expertise-item__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray-500);
    margin: 0;
  }

  /* ── CTA section ── */
  .cta-section {
    border-top: 1px solid var(--color-gray-200);
    background-color: var(--color-gray-50);
  }
  :global([data-theme="dark"]) .cta-section {
    background-color: #0f0f0f;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-600);
    max-width: 36rem;
    margin: 0 0 2rem;
  }
  :global([data-theme="dark"]) .cta-desc {
    color: #a3a3a3;
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium);
    border-radius: 2rem;
    transition: all var(--transition-base);
    text-decoration: none;
  }

  .cta-button--primary {
    color: var(--color-white);
    background-color: var(--color-black);
  }
  :global([data-theme="dark"]) .cta-button--primary {
    color: #0a0a0a;
    background-color: #ffffff;
  }

  .cta-button--secondary {
    color: var(--color-black);
    background-color: transparent;
    border: 1px solid var(--color-gray-300);
  }
  :global([data-theme="dark"]) .cta-button--secondary {
    color: #ffffff;
    background-color: transparent;
    border-color: #404040;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    opacity: 1;
  }
  .cta-button--primary:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }
  .cta-button--secondary:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
    border-color: var(--color-gray-400);
  }

  /* ── Animations ── */
  .hero-label,
  .hero-title,
  .hero-role {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s ease forwards;
  }
  .hero-title {
    animation-delay: 0.1s;
  }
  .hero-role {
    animation-delay: 0.2s;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Tablet ── */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 4.5rem;
    }
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      min-height: calc(100vh - 4rem);
      padding: 3rem 1.5rem;
    }
    .hero-title {
      font-size: 3.25rem;
    }
    .hero-role {
      font-size: 1.25rem;
    }
    .section {
      padding: 3.5rem 1.5rem;
    }
    .section-heading {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .expertise-grid {
      grid-template-columns: 1fr;
    }
    .cta-buttons {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const onScroll = () => {
    if (reduceMotion) return;
    const el = document.querySelector(".hero-container");
    if (!(el instanceof HTMLElement)) return;

    const offset = Math.min(window.scrollY * 0.35, 48);
    el.style.transform = `translateY(${offset}px)`;
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
