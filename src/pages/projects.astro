      techStack: ["Kotlin", "Jetpack Compose", "Ktor", "Room", "Koin"],
      ctaText: "Ver Proyecto",
      ctaLink: "https://github.com/Ivanmw97/CryptoTracker",
      imageUrl: getProjectImage("cryptotracker"),
